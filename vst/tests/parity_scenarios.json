[
  { "name": "defaults: sine bass 55 Hz", "blocks": 750, "source": { "type": "sine", "freq": 55, "level": 0.5 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "defaults: saw 110 Hz, free LFO 3 Hz", "blocks": 750, "params": { "lfoSync": 0, "lfoRate": 3 }, "source": { "type": "saw", "freq": 110, "level": 0.4 } },
  { "name": "defaults: chord, transport stopped (free-run at the division)", "blocks": 750, "source": { "type": "chord", "freq": 110, "level": 0.4 }, "transport": { "bpm": 174, "playing": false } },
  { "name": "defaults: drum loop", "blocks": 750, "source": { "type": "drums", "level": 0.6 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "defaults: noise", "blocks": 375, "source": { "type": "noise", "level": 0.3 } },
  { "name": "silence stays silent", "blocks": 375, "source": { "type": "silence" } },

  { "name": "auto gain: quiet sine comes up", "blocks": 1500, "params": { "mix": 0 }, "source": { "type": "sine", "freq": 110, "level": 0.01 } },
  { "name": "auto gain: loud sine comes down", "blocks": 1500, "params": { "mix": 0 }, "source": { "type": "sine", "freq": 110, "level": 0.9 } },
  { "name": "auto gain off, input gain +12", "blocks": 375, "params": { "autoIn": 0, "inGain": 12, "mix": 0 }, "source": { "type": "saw", "freq": 110, "level": 0.1 } },

  { "name": "LFO: triangle 1/4 at 140 BPM", "blocks": 750, "params": { "lfoShape": 1, "lfoDiv": 3 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 140, "playing": true } },
  { "name": "LFO: saw down 1/2", "blocks": 750, "params": { "lfoShape": 2, "lfoDiv": 1 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "LFO: saw up 1/16, phase 90", "blocks": 750, "params": { "lfoShape": 3, "lfoDiv": 9, "lfoPhase": 90 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "LFO: square 1/8 no smoothing", "blocks": 750, "params": { "lfoShape": 4, "lfoSmooth": 0 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "LFO: square 1/8 heavy smoothing", "blocks": 750, "params": { "lfoShape": 4, "lfoSmooth": 0.8 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "LFO: sample & hold 1/16T", "blocks": 750, "params": { "lfoShape": 5, "lfoDiv": 11 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "LFO: smooth random 1/4", "blocks": 750, "params": { "lfoShape": 6, "lfoDiv": 3 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "LFO: free 0.3 Hz dotted ignored", "blocks": 1500, "params": { "lfoSync": 0, "lfoRate": 0.3, "lfoDiv": 4 }, "source": { "type": "saw", "freq": 110, "level": 0.4 } },
  { "name": "LFO: free 18 Hz", "blocks": 375, "params": { "lfoSync": 0, "lfoRate": 18, "lfoSmooth": 0 }, "source": { "type": "saw", "freq": 110, "level": 0.4 } },
  { "name": "LFO: stereo offset 90, wide source", "blocks": 750, "params": { "lfoStereo": 90 }, "source": { "type": "wide", "freq": 82.4, "level": 0.3 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "LFO: stereo offset 180, square", "blocks": 750, "params": { "lfoStereo": 180, "lfoShape": 4 }, "source": { "type": "wide", "freq": 82.4, "level": 0.3 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "LFO: retrigger by MIDI note", "blocks": 750, "params": { "lfoSync": 0, "lfoRate": 1, "lfoRetrig": 1, "lfoShape": 3 }, "source": { "type": "saw", "freq": 110, "level": 0.4 },
    "events": [[200, "on", 48, 100], [400, "off", 48], [500, "on", 60]] },
  { "name": "LFO: RETRIG button", "blocks": 750, "params": { "lfoSync": 0, "lfoRate": 1, "lfoShape": 3 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "events": [[300, "retrig"]] },
  { "name": "LFO: tempo change while playing", "blocks": 750, "params": { "lfoDiv": 3 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true },
    "events": [[375, "transport", 90, 1, 10.0]] },
  { "name": "LFO: transport starts mid-way at ppq 3.5", "blocks": 750, "params": { "lfoDiv": 6 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 128, "playing": false },
    "events": [[300, "transport", 128, 1, 3.5]] },

  { "name": "filter: LP sweep 40..8k, reso 0.8", "blocks": 750, "params": { "cutoffLo": 40, "cutoffHi": 8000, "reso": 0.8 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "filter: BP", "blocks": 750, "params": { "filterType": 1, "reso": 0.6 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "filter: HP", "blocks": 750, "params": { "filterType": 2, "cutoffLo": 60, "cutoffHi": 2000 }, "source": { "type": "chord", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "filter: notch", "blocks": 750, "params": { "filterType": 3, "reso": 0.9 }, "source": { "type": "noise", "level": 0.3 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "filter: formant morph on a saw", "blocks": 750, "params": { "filterType": 4, "reso": 0.5 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "filter: formant on noise, reso 1", "blocks": 750, "params": { "filterType": 4, "reso": 1 }, "source": { "type": "noise", "level": 0.3 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "filter: reso 1, limit 0 (hot)", "blocks": 750, "params": { "reso": 1, "resoLimit": 0 }, "source": { "type": "saw", "freq": 110, "level": 0.6 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "filter: reso 1, limit 1 (tamed)", "blocks": 750, "params": { "reso": 1, "resoLimit": 1 }, "source": { "type": "saw", "freq": 110, "level": 0.6 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "filter: reso 0, depth 0.3", "blocks": 750, "params": { "reso": 0, "midDepth": 0.3 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "filter: type changes mid-way", "blocks": 750, "params": {}, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true },
    "events": [[150, "param", "filterType", 1], [300, "param", "filterType", 4], [450, "param", "filterType", 2], [600, "param", "filterType", 0]] },
  { "name": "filter: cutoff automation", "blocks": 750, "params": { "midDepth": 0 }, "source": { "type": "saw", "freq": 110, "level": 0.4 },
    "events": [[0, "param", "cutoffLo", 100], [0, "param", "cutoffHi", 100], [200, "param", "cutoffLo", 400], [200, "param", "cutoffHi", 400], [400, "param", "cutoffLo", 3000], [400, "param", "cutoffHi", 3000], [600, "param", "reso", 0.9]] },

  { "name": "drive: 1x, drive 1, pre", "blocks": 375, "params": { "os": 0, "midDrive": 1 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "drive: 2x, drive 1, pre", "blocks": 375, "params": { "os": 1, "midDrive": 1 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "drive: 4x, drive 1, post", "blocks": 375, "params": { "os": 2, "midDrive": 1, "drivePos": 1 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true } },
  { "name": "drive: 4x on a 5 kHz sine (aliasing)", "blocks": 375, "params": { "os": 2, "midDrive": 1, "midWob": 0 }, "source": { "type": "sine", "freq": 5000, "level": 0.5 } },
  { "name": "drive: tone 0 / 0.5 / 1 changes", "blocks": 750, "params": { "midDrive": 0.8 }, "source": { "type": "saw", "freq": 110, "level": 0.4 }, "transport": { "bpm": 120, "playing": true },
